{
  "name": "blackbox",
  "version": "0.1.0",
  "description": "Local flight recorder and judge for AI agents: OTLP ingest, LLM proxy, MCP wrapper, agent signals, LLM judges, datasets and experiments",
  "type": "module",
  "private": true,
  "bin": { "blackbox": "bin/blackbox.ts" },
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/cli.ts serve",
    "demo": "node src/cli.ts demo",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts"
  },
  "dependencies": {
    "protobufjs": "8.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^6.0.0",
    "vite": "8.3.3"
  }
}
